{
  "name": "motoboycontas",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "MotoboyContas — PWA de controle financeiro para motoboys (Vue 3 + Vuetify + Firebase)",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
