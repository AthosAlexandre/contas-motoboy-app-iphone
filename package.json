    "test:watch": "vitest",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint .",
    "icons": "pwa-assets-generator"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "pinia": "^3.0.4",
    "vue": "^3.5.42",
